<!-- Stats Cards Section -->
<section style="padding: 80px 0;">
  <div class="container">
    <div style="text-align: center; margin-bottom: 60px; animation: fadeInUp 0.8s ease;">
      <h2 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem;">Our Impact</h2>
      <p style="font-size: 1.1rem; color: #666;">Trusted by thousands of vendors across Africa</p>
    </div>

    <div class="row">
      <!-- Stat 1: Stores -->
      <div class="col-md-6 col-lg-3 mb-4">
        <div style="background: white; border-radius: 15px; padding: 40px; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08); transition: all 0.3s ease; text-align: center; animation: fadeInUp 0.8s ease; animation-delay: 0.1s; animation-fill-mode: both;" onmouseover="this.style.transform='translateY(-10px)'; this.style.boxShadow='0 20px 40px rgba(37, 211, 102, 0.2)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 5px 20px rgba(0, 0, 0, 0.08)'">
          <div style="font-size: 2.5rem; color: #25D366; margin-bottom: 1.5rem;">
            <i class="fas fa-store"></i>
          </div>
          <div style="font-size: 2.5rem; font-weight: 700; color: #25D366; margin-bottom: 0.5rem; animation: pulse 2s ease-in-out infinite;">12,000+</div>
          <div style="font-size: 1.1rem; color: #666; font-weight: 600;">Active Stores</div>
          <div style="color: #999; margin-top: 1rem; font-size: 0.9rem;">Growing every day</div>
        </div>
      </div>

      <!-- Stat 2: Customers -->
      <div class="col-md-6 col-lg-3 mb-4">
        <div style="background: white; border-radius: 15px; padding: 40px; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08); transition: all 0.3s ease; text-align: center; animation: fadeInUp 0.8s ease; animation-delay: 0.2s; animation-fill-mode: both;" onmouseover="this.style.transform='translateY(-10px)'; this.style.boxShadow='0 20px 40px rgba(37, 211, 102, 0.2)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 5px 20px rgba(0, 0, 0, 0.08)'">
          <div style="font-size: 2.5rem; color: #25D366; margin-bottom: 1.5rem;">
            <i class="fas fa-users"></i>
          </div>
          <div style="font-size: 2.5rem; font-weight: 700; color: #25D366; margin-bottom: 0.5rem; animation: pulse 2s ease-in-out infinite;">5M+</div>
          <div style="font-size: 1.1rem; color: #666; font-weight: 600;">Customers Served</div>
          <div style="color: #999; margin-top: 1rem; font-size: 0.9rem;">Monthly active</div>
        </div>
      </div>

      <!-- Stat 3: Processed Volume -->
      <div class="col-md-6 col-lg-3 mb-4">
        <div style="background: white; border-radius: 15px; padding: 40px; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08); transition: all 0.3s ease; text-align: center; animation: fadeInUp 0.8s ease; animation-delay: 0.3s; animation-fill-mode: both;" onmouseover="this.style.transform='translateY(-10px)'; this.style.boxShadow='0 20px 40px rgba(37, 211, 102, 0.2)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 5px 20px rgba(0, 0, 0, 0.08)'">
          <div style="font-size: 2.5rem; color: #25D366; margin-bottom: 1.5rem;">
            <i class="fas fa-naira-sign"></i>
          </div>
          <div style="font-size: 2.5rem; font-weight: 700; color: #25D366; margin-bottom: 0.5rem; animation: pulse 2s ease-in-out infinite;">₦2.5B+</div>
          <div style="font-size: 1.1rem; color: #666; font-weight: 600;">Processed Volume</div>
          <div style="color: #999; margin-top: 1rem; font-size: 0.9rem;">In total transactions</div>
        </div>
      </div>

      <!-- Stat 4: Uptime -->
      <div class="col-md-6 col-lg-3 mb-4">
        <div style="background: white; border-radius: 15px; padding: 40px; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08); transition: all 0.3s ease; text-align: center; animation: fadeInUp 0.8s ease; animation-delay: 0.4s; animation-fill-mode: both;" onmouseover="this.style.transform='translateY(-10px)'; this.style.boxShadow='0 20px 40px rgba(37, 211, 102, 0.2)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 5px 20px rgba(0, 0, 0, 0.08)'">
          <div style="font-size: 2.5rem; color: #25D366; margin-bottom: 1.5rem;">
            <i class="fas fa-chart-line"></i>
          </div>
          <div style="font-size: 2.5rem; font-weight: 700; color: #25D366; margin-bottom: 0.5rem; animation: pulse 2s ease-in-out infinite;">99.9%</div>
          <div style="font-size: 1.1rem; color: #666; font-weight: 600;">Platform Uptime</div>
          <div style="color: #999; margin-top: 1rem; font-size: 0.9rem;">Always available</div>
        </div>
      </div>
    </div>
  </div>
</section>
