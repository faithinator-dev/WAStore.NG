      padding: 0.6rem 1.5rem;
      border-radius: 25px;
      transition: all 0.3s ease;
    }

    .btn-primary:hover {
      background: #1ea854;
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(37, 211, 102, 0.3);
    }

    /* Hero Section */
