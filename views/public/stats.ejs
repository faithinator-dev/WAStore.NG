  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Counter animation
    function animateCounter(element, target, duration = 2000) {
      const increment = target / (duration / 16);
      let current = 0;
      const counter = setInterval(() => {
        current += increment;
        if (current >= target) {
          current = target;
          clearInterval(counter);
        }
        element.textContent = Math.floor(current).toLocaleString();
      }, 16);
    }

    // Animate on scroll
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const element = entry.target;
          if (element.id === 'storeCount') animateCounter(element, 12000);
          if (element.id === 'customerCount') element.textContent = '5M+';
          if (element.id === 'processedValue') element.textContent = '₦2.5B+';
          if (element.id === 'uptime') element.textContent = '99.9%';
          observer.unobserve(element);
        }
      });
    });

    document.querySelectorAll('.stat-value').forEach(el => observer.observe(el));
  </script>
