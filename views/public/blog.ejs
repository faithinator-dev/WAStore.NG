<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blog - WAStore News & Tips</title>
  <%- include('partials/styles') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <!-- Hero Section -->
  <section style="background: linear-gradient(135deg, #25D366 0%, #128C52 100%); color: white; padding: 60px 0; text-align: center; animation: fadeInUp 0.8s ease;">
    <div class="container">
      <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem;">WAStore Blog</h1>
      <p style="font-size: 1.1rem; margin-bottom: 2rem; opacity: 0.95;">Tips, insights, and stories from our community of sellers</p>
    </div>
  </section>

  <!-- Blog Posts Section -->
  <section style="padding: 80px 0; background: white;">
    <div class="container">
      <div class="row">
        <!-- Post 1 -->
        <div class="col-lg-6 mb-4">
          <div style="background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08); transition: all 0.3s ease; animation: fadeInUp 0.8s ease; animation-delay: 0.1s; animation-fill-mode: both;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 30px rgba(37, 211, 102, 0.15)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 5px 20px rgba(0, 0, 0, 0.08)'">
            <div style="background: linear-gradient(135deg, #25D366 0%, #128C52 100%); padding: 40px; color: white; text-align: center; min-height: 200px; display: flex; align-items: center; justify-content: center;">
              <i class="fas fa-chart-line" style="font-size: 4rem;"></i>
            </div>
            <div style="padding: 30px;">
              <div style="color: #25D366; font-weight: 600; font-size: 0.85rem; margin-bottom: 0.5rem;">May 10, 2024</div>
              <h3 style="font-size: 1.5rem; font-weight: 700; color: #333; margin-bottom: 1rem;">5 Ways to Increase Your Sales on WAStore</h3>
              <p style="color: #666; line-height: 1.6; margin-bottom: 1.5rem;">Discover proven strategies that our top sellers use to grow their revenue by 3x within 3 months. From product photography to customer engagement...</p>
              <a href="#" style="color: #25D366; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
                Read More <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>

        <!-- Post 2 -->
        <div class="col-lg-6 mb-4">
          <div style="background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08); transition: all 0.3s ease; animation: fadeInUp 0.8s ease; animation-delay: 0.2s; animation-fill-mode: both;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 30px rgba(37, 211, 102, 0.15)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 5px 20px rgba(0, 0, 0, 0.08)'">
            <div style="background: linear-gradient(135deg, #25D366 0%, #128C52 100%); padding: 40px; color: white; text-align: center; min-height: 200px; display: flex; align-items: center; justify-content: center;">
              <i class="fas fa-lock" style="font-size: 4rem;"></i>
            </div>
            <div style="padding: 30px;">
              <div style="color: #25D366; font-weight: 600; font-size: 0.85rem; margin-bottom: 0.5rem;">May 8, 2024</div>
              <h3 style="font-size: 1.5rem; font-weight: 700; color: #333; margin-bottom: 1rem;">How to Keep Your Customer Data Safe</h3>
              <p style="color: #666; line-height: 1.6; margin-bottom: 1.5rem;">A comprehensive guide on data security best practices for online merchants. Learn how WAStore protects your business and customer information...</p>
              <a href="#" style="color: #25D366; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
                Read More <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>

