<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Documentation - WAStore API & Guides</title>
  <%- include('partials/styles') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <!-- Hero Section -->
  <section style="background: linear-gradient(135deg, #25D366 0%, #128C52 100%); color: white; padding: 60px 0; text-align: center; animation: fadeInUp 0.8s ease;">
    <div class="container">
      <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem;">Documentation</h1>
      <p style="font-size: 1.1rem; margin-bottom: 2rem; opacity: 0.95;">Developer guides and API reference</p>
    </div>
  </section>

  <!-- Documentation Section -->
  <section style="padding: 80px 0; background: white;">
    <div class="container">
      <div class="row">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3 mb-4 mb-lg-0">
          <div style="position: sticky; top: 100px;">
            <div style="background: #f8f9fa; padding: 30px; border-radius: 15px;">
              <h4 style="font-weight: 700; color: #333; margin-bottom: 1.5rem;">Quick Links</h4>
              <nav style="display: flex; flex-direction: column; gap: 1rem;">
                <a href="#getting-started" style="color: #25D366; text-decoration: none; font-weight: 600; transition: all 0.3s ease;" onmouseover="this.style.paddingLeft='10px'" onmouseout="this.style.paddingLeft='0'">
                  <i class="fas fa-arrow-right"></i> Getting Started
                </a>
                <a href="#authentication" style="color: #666; text-decoration: none; font-weight: 600; transition: all 0.3s ease;" onmouseover="this.style.paddingLeft='10px'; this.style.color='#25D366'" onmouseout="this.style.paddingLeft='0'; this.style.color='#666'">
                  <i class="fas fa-arrow-right"></i> Authentication
                </a>
                <a href="#products-api" style="color: #666; text-decoration: none; font-weight: 600; transition: all 0.3s ease;" onmouseover="this.style.paddingLeft='10px'; this.style.color='#25D366'" onmouseout="this.style.paddingLeft='0'; this.style.color='#666'">
                  <i class="fas fa-arrow-right"></i> Products API
                </a>
                <a href="#orders-api" style="color: #666; text-decoration: none; font-weight: 600; transition: all 0.3s ease;" onmouseover="this.style.paddingLeft='10px'; this.style.color='#25D366'" onmouseout="this.style.paddingLeft='0'; this.style.color='#666'">
                  <i class="fas fa-arrow-right"></i> Orders API
                </a>
                <a href="#webhooks" style="color: #666; text-decoration: none; font-weight: 600; transition: all 0.3s ease;" onmouseover="this.style.paddingLeft='10px'; this.style.color='#25D366'" onmouseout="this.style.paddingLeft='0'; this.style.color='#666'">
                  <i class="fas fa-arrow-right"></i> Webhooks
                </a>
              </nav>
            </div>
          </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
          <!-- Getting Started -->
          <div style="animation: fadeInUp 0.8s ease;">
            <h2 id="getting-started" style="font-size: 2rem; font-weight: 700; color: #333; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 2px solid #e8f5e9;">Getting Started</h2>
            
            <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 2rem;">
              <p style="color: #666; line-height: 1.8; margin: 0;">Welcome to the WAStore API documentation. This guide will help you integrate WAStore with your applications. All API requests require authentication using API keys.</p>
            </div>

            <h3 style="font-size: 1.3rem; font-weight: 700; color: #333; margin-bottom: 1rem;">Base URL</h3>
            <div style="background: #f0f0f0; padding: 15px; border-radius: 8px; border-left: 4px solid #25D366; margin-bottom: 2rem; font-family: monospace;">
              https://api.wastore.ng/v1
            </div>

            <h3 style="font-size: 1.3rem; font-weight: 700; color: #333; margin-bottom: 1rem;">Rate Limits</h3>
            <ul style="color: #666; line-height: 1.8; margin-bottom: 2rem;">
              <li>Free Plan: 100 requests/hour</li>
              <li>Pro Plan: 1,000 requests/hour</li>
              <li>Enterprise: Custom limits</li>
            </ul>
          </div>

          <!-- Authentication -->
          <div style="margin-top: 60px; animation: fadeInUp 0.8s ease 0.1s both;">
            <h2 id="authentication" style="font-size: 2rem; font-weight: 700; color: #333; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 2px solid #e8f5e9;">Authentication</h2>
            
            <p style="color: #666; line-height: 1.8; margin-bottom: 1.5rem;">All API requests require an API key in the Authorization header:</p>
            
            <div style="background: #f0f0f0; padding: 15px; border-radius: 8px; border-left: 4px solid #25D366; margin-bottom: 2rem; font-family: monospace; overflow-x: auto;">
              Authorization: Bearer YOUR_API_KEY
            </div>

            <p style="color: #666; line-height: 1.8; margin-bottom: 1.5rem;">You can find your API key in Settings > API Keys. Keep your API key secure and never share it publicly.</p>
          </div>

          <!-- Products API -->
          <div style="margin-top: 60px; animation: fadeInUp 0.8s ease 0.2s both;">
            <h2 id="products-api" style="font-size: 2rem; font-weight: 700; color: #333; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 2px solid #e8f5e9;">Products API</h2>
            
            <h3 style="font-size: 1.3rem; font-weight: 700; color: #333; margin-bottom: 1rem;">List Products</h3>
            <div style="background: #f0f0f0; padding: 15px; border-radius: 8px; border-left: 4px solid #25D366; margin-bottom: 1rem; font-family: monospace; overflow-x: auto;">
              GET /products
            </div>
            
            <div style="background: white; border: 1px solid #e0e0e0; padding: 20px; border-radius: 8px; margin-bottom: 2rem;">
              <p style="color: #666; margin-bottom: 1rem;"><strong>Response:</strong></p>
              <pre style="background: #f5f5f5; padding: 15px; border-radius: 8px; overflow-x: auto; color: #333;"><code>{
  "data": [
    {
      "id": "123",
      "name": "Product Name",
      "price": 5000,
      "stock": 100,
      "status": "active"
    }
  ],
  "count": 1
}</code></pre>
            </div>

            <h3 style="font-size: 1.3rem; font-weight: 700; color: #333; margin-bottom: 1rem;">Get Single Product</h3>
            <div style="background: #f0f0f0; padding: 15px; border-radius: 8px; border-left: 4px solid #25D366; margin-bottom: 2rem; font-family: monospace; overflow-x: auto;">
              GET /products/{id}
            </div>
          </div>

          <!-- Orders API -->
          <div style="margin-top: 60px; animation: fadeInUp 0.8s ease 0.3s both;">
            <h2 id="orders-api" style="font-size: 2rem; font-weight: 700; color: #333; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 2px solid #e8f5e9;">Orders API</h2>
            
            <h3 style="font-size: 1.3rem; font-weight: 700; color: #333; margin-bottom: 1rem;">List Orders</h3>
            <div style="background: #f0f0f0; padding: 15px; border-radius: 8px; border-left: 4px solid #25D366; margin-bottom: 1rem; font-family: monospace; overflow-x: auto;">
              GET /orders
            </div>
            
            <div style="background: white; border: 1px solid #e0e0e0; padding: 20px; border-radius: 8px; margin-bottom: 2rem;">
              <p style="color: #666; margin-bottom: 1rem;"><strong>Query Parameters:</strong></p>
              <ul style="color: #666;">
                <li>status: (optional) pending, completed, cancelled</li>
                <li>limit: (optional) Number of results, default 50</li>
                <li>offset: (optional) Pagination offset</li>
              </ul>
            </div>

            <h3 style="font-size: 1.3rem; font-weight: 700; color: #333; margin-bottom: 1rem;">Get Single Order</h3>
            <div style="background: #f0f0f0; padding: 15px; border-radius: 8px; border-left: 4px solid #25D366; margin-bottom: 2rem; font-family: monospace; overflow-x: auto;">
              GET /orders/{id}
            </div>
          </div>

          <!-- Webhooks -->
          <div style="margin-top: 60px; animation: fadeInUp 0.8s ease 0.4s both;">
            <h2 id="webhooks" style="font-size: 2rem; font-weight: 700; color: #333; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 2px solid #e8f5e9;">Webhooks</h2>
            
            <p style="color: #666; line-height: 1.8; margin-bottom: 1.5rem;">Webhooks allow you to receive real-time notifications about events in your store. Configure webhooks in Settings > Webhooks.</p>

            <h3 style="font-size: 1.3rem; font-weight: 700; color: #333; margin-bottom: 1rem;">Webhook Events</h3>
            <ul style="color: #666; line-height: 1.8;">
              <li><strong>order.created</strong> - When a new order is placed</li>
              <li><strong>order.completed</strong> - When payment is confirmed</li>
              <li><strong>order.cancelled</strong> - When an order is cancelled</li>
              <li><strong>product.created</strong> - When a new product is added</li>
              <li><strong>product.updated</strong> - When a product is modified</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>
</body>
</html>
